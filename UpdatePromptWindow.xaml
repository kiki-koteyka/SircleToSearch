<ui:FluentWindow x:Class="SircleToSearch.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SircleToSearch" Height="260" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SircleToSearch" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20,4,20,20">
            <TextBlock x:Name="QuestionText" FontSize="16" FontFamily="Segoe UI Semibold"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="HintText" Opacity="0.7" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <ui:CardControl Margin="0,0,0,20">
                <ui:CardControl.Header>
                    <TextBlock x:Name="AutoUpdateLabel" VerticalAlignment="Center" FontSize="13"/>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoUpdateToggle" Checked="AutoUpdateToggle_Changed" Unchecked="AutoUpdateToggle_Changed"/>
            </ui:CardControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="LaterButton" Appearance="Secondary" Margin="0,0,8,0" Click="LaterButton_Click"/>
                <ui:Button x:Name="UpdateButton" Appearance="Primary" Click="UpdateButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
