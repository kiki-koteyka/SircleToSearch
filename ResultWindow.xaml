<Window x:Class="SircleToSearch.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SircleToSearch - результат"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="White" CornerRadius="16,16,0,0"
            BorderBrush="#22000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#F1F3F4"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#009FAA"/>
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0"
                                   FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#3C4043"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button x:Name="SettingsButton" Content="⚙" Width="32" Height="32" Margin="0,0,4,0"
                                BorderThickness="0" Background="Transparent" Foreground="#5F6368"
                                FontSize="14" Cursor="Hand" Click="SettingsButton_Click"/>
                        <Button x:Name="CloseButton" Content="✕" Width="32" Height="32"
                                BorderThickness="0" Background="Transparent" Foreground="#5F6368"
                                FontSize="13" Cursor="Hand" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="1" Visibility="Collapsed"/>

            <Border x:Name="LoadingOverlay" Grid.Row="1" Background="White" CornerRadius="0,0,16,16">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="76" Height="76" Fill="#CCE9EC"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Polygon x:Name="SpinnerShape" Fill="#009FAA" Width="48" Height="48"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
                </Grid>
            </Border>

            <Border x:Name="ErrorOverlay" Grid.Row="1" Background="White" CornerRadius="0,0,16,16"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center"
                               FontFamily="Segoe UI" FontSize="13" Foreground="#5F6368"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
