<ui:FluentWindow x:Class="SircleToSearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SircleToSearch" Height="640" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Background="#F3F3F3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SircleToSearch - by Kiki" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#EAEBEC" Margin="0,8,0,0">
            <Border x:Name="NavGeneral" Height="48" Cursor="Hand" MouseLeftButtonUp="NavGeneral_Click" Tag="0">
                <Grid>
                    <Rectangle x:Name="NavGeneralAccent" Width="3" HorizontalAlignment="Left" Fill="#009FAA" Visibility="Collapsed"/>
                    <ui:SymbolIcon Symbol="Home24" FontSize="20"/>
                </Grid>
            </Border>
            <Border x:Name="NavSearch" Height="48" Cursor="Hand" MouseLeftButtonUp="NavSearch_Click" Tag="1">
                <Grid>
                    <Rectangle x:Name="NavSearchAccent" Width="3" HorizontalAlignment="Left" Fill="#009FAA" Visibility="Collapsed"/>
                    <ui:SymbolIcon Symbol="Search24" FontSize="20"/>
                </Grid>
            </Border>
            <Border x:Name="NavSelection" Height="48" Cursor="Hand" MouseLeftButtonUp="NavSelection_Click" Tag="2">
                <Grid>
                    <Rectangle x:Name="NavSelectionAccent" Width="3" HorizontalAlignment="Left" Fill="#009FAA" Visibility="Collapsed"/>
                    <ui:SymbolIcon Symbol="Crop24" FontSize="20"/>
                </Grid>
            </Border>
            <Border x:Name="NavUpdates" Height="48" Cursor="Hand" MouseLeftButtonUp="NavUpdates_Click" Tag="3">
                <Grid>
                    <Rectangle x:Name="NavUpdatesAccent" Width="3" HorizontalAlignment="Left" Fill="#009FAA" Visibility="Collapsed"/>
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20"/>
                </Grid>
            </Border>
            <Border x:Name="NavAbout" Height="48" Cursor="Hand" MouseLeftButtonUp="NavAbout_Click" Tag="4">
                <Grid>
                    <Rectangle x:Name="NavAboutAccent" Width="3" HorizontalAlignment="Left" Fill="#009FAA" Visibility="Collapsed"/>
                    <ui:SymbolIcon Symbol="Info24" FontSize="20"/>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel"
                      ScrollChanged="SettingsScrollViewer_ScrollChanged">
        <StackPanel x:Name="SettingsContentPanel" Margin="20,12,20,20">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="SettingsContentTransform"/>
            </StackPanel.RenderTransform>

            <StackPanel x:Name="PageGeneral">
                <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,0,0,16"/>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                    <ui:CardControl.Header>
                        <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" FontSize="14"/>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="LanguageCombo" Width="140" SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Русский" Tag="ru"/>
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <TextBlock x:Name="AutostartLabel" VerticalAlignment="Center" FontSize="14"/>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AutostartToggle"
                                     Checked="AutostartToggle_Changed" Unchecked="AutostartToggle_Changed"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Keyboard24}">
                    <ui:CardControl.Header>
                        <TextBlock x:Name="HotkeyLabel" VerticalAlignment="Center" FontSize="14"/>
                    </ui:CardControl.Header>
                    <Border x:Name="HotkeyBox" Background="#F1F3F4" CornerRadius="6" Padding="12,6"
                            Cursor="Hand" Focusable="True" MinWidth="140" HorizontalAlignment="Right"
                            MouseLeftButtonDown="HotkeyBox_MouseLeftButtonDown"
                            GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus"
                            PreviewKeyDown="HotkeyBox_PreviewKeyDown">
                        <TextBlock x:Name="HotkeyDisplayText" FontFamily="Consolas" FontSize="13"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </ui:CardControl>

                <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <TextBlock x:Name="AccentColorLabel" VerticalAlignment="Center" FontSize="14"/>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="0,4,0,4">
                        <StackPanel x:Name="AccentSwatchPanel" Orientation="Horizontal"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBox x:Name="AccentHexBox" Width="110" MaxLength="7"
                                     KeyDown="AccentHexBox_KeyDown" LostFocus="AccentHexBox_LostFocus"/>
                            <ui:Button x:Name="AccentHexApplyButton" Appearance="Secondary" Margin="8,0,0,0"
                                       Click="AccentHexApplyButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>

            <StackPanel x:Name="PageSearch" Visibility="Collapsed">
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Search24}">
                    <ui:CardControl.Header>
                        <TextBlock x:Name="SearchEngineLabel" VerticalAlignment="Center" FontSize="14"/>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="SearchEngineCombo" Width="210" SelectionChanged="SearchEngineCombo_SelectionChanged">
                        <ComboBoxItem x:Name="SearchEngineGoogleItem" Tag="Google"/>
                        <ComboBoxItem Content="Yandex" Tag="Yandex"/>
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl x:Name="FastSearchCard" Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock x:Name="FastSearchLabel" VerticalAlignment="Center" FontSize="14"/>
                            <TextBlock x:Name="FastSearchHint" FontSize="12" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="FastSearchToggle"
                                     Checked="FastSearchToggle_Changed" Unchecked="FastSearchToggle_Changed"/>
                </ui:CardControl>
            </StackPanel>

            <StackPanel x:Name="PageSelection" Visibility="Collapsed">
                <TextBlock x:Name="SelectionHintText" TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,0,0,12"/>

                <Border x:Name="PreviewCard" Width="454" Height="190" CornerRadius="8" ClipToBounds="True"
                        HorizontalAlignment="Left" Margin="0,0,0,16"
                        MouseLeftButtonDown="PreviewCard_MouseLeftButtonDown"
                        MouseMove="PreviewCard_MouseMove"
                        MouseLeftButtonUp="PreviewCard_MouseLeftButtonUp"
                        LostMouseCapture="PreviewCard_LostMouseCapture">
                    <Grid Background="#1c262b">
                        <Image Source="pack://application:,,,/Resources/cat-preview.jpg" Stretch="UniformToFill"
                               VerticalAlignment="Top" Margin="0,-80,0,0"/>

                        <Path x:Name="PreviewDim" Fill="#8C000000"/>
                        <Canvas>
                            <Rectangle x:Name="PreviewGlow" Fill="Transparent"/>
                            <Canvas x:Name="PreviewHandles"/>
                        </Canvas>
                    </Grid>
                </Border>

                <TextBlock x:Name="BracketsSectionLabel" FontSize="12" FontWeight="SemiBold" Opacity="0.55"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HugLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="HugSlider" Grid.Column="1" Minimum="0" Maximum="24" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="HugValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CornerRadiusLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="CornerRadiusSlider" Grid.Column="1" Minimum="0" Maximum="30" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="CornerRadiusValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ArmLengthLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="ArmLengthSlider" Grid.Column="1" Minimum="6" Maximum="40" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="ArmLengthValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ThicknessLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="ThicknessSlider" Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="ThicknessValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <TextBlock x:Name="GlowSectionLabel" FontSize="12" FontWeight="SemiBold" Opacity="0.55"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GlowGapLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="GlowGapSlider" Grid.Column="1" Minimum="0" Maximum="24" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="GlowGapValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GlowThicknessLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="GlowThicknessSlider" Grid.Column="1" Minimum="2" Maximum="24" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="GlowThicknessValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GlowBlurLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="GlowBlurSlider" Grid.Column="1" Minimum="0" Maximum="30" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="GlowBlurValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GlowOpacityLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="GlowOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="GlowOpacityValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <TextBlock x:Name="AreaSectionLabel" FontSize="12" FontWeight="SemiBold" Opacity="0.55"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionRadiusLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="13"/>
                    <Slider x:Name="SelectionRadiusSlider" Grid.Column="1" Minimum="0" Maximum="30" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SelectionSlider_ValueChanged"/>
                    <TextBlock x:Name="SelectionRadiusValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                </Grid>

                <ui:Button x:Name="SelectionResetButton" Appearance="Secondary" HorizontalAlignment="Left"
                           Click="SelectionResetButton_Click"/>
            </StackPanel>

            <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowCounterclockwise24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock x:Name="VersionText" FontSize="14"/>
                            <TextBlock x:Name="UpdateStatusText" FontSize="12" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button x:Name="CheckUpdateButton" Appearance="Secondary" Click="CheckUpdateButton_Click"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <TextBlock x:Name="AutoUpdateLabel" VerticalAlignment="Center" FontSize="14"/>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AutoUpdateToggle"
                                     Checked="AutoUpdateToggle_Changed" Unchecked="AutoUpdateToggle_Changed"/>
                </ui:CardControl>
            </StackPanel>

            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ui:Button x:Name="GitHubButton" Appearance="Secondary" Margin="0,0,8,0" Click="GitHubButton_Click"/>
                    <ui:Button x:Name="AuthorButton" Appearance="Secondary" Click="AuthorButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="BySomeoneText" Opacity="0.5" FontSize="11"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="20,0,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ReportBugButton" Appearance="Secondary" Icon="{ui:SymbolIcon Bug24}"
                           Margin="0,0,8,0" Click="ReportBugButton_Click"/>
                <ui:Button x:Name="CloseButton" Appearance="Primary" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
        </Grid>

        <Border x:Name="ScrollTrack" Grid.Column="2" Width="4" Margin="0,4,4,4"
                VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="Transparent">
            <Border x:Name="ScrollThumb" Width="4" CornerRadius="2" Background="#40000000"
                    VerticalAlignment="Top">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ScrollThumbTransform"/>
                </Border.RenderTransform>
            </Border>
        </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
